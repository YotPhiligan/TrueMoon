        <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
        <PackageTags>$(PackageTags);ui;rendering;sessions;dispatcher</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\TrueMoon.Argentis\TrueMoon.Argentis.csproj" />
