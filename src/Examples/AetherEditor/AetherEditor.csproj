<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrueMoon.Examples.AetherEditor</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>Minimal Aether editor composition with explicit standalone runtime and host-owned fonts.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../TrueMoon/TrueMoon.csproj" />
    <ProjectReference Include="../../TrueMoon.Aether.Editor/TrueMoon.Aether.Editor.csproj" />
    <None Update="Assets/Fonts/NotoSans-Regular.ttf;Assets/Fonts/OFL.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
