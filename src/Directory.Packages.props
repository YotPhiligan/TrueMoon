<Project>
  <PropertyGroup>
    <!-- An explicit import into an external/frozen project must not opt it into repository CPM. -->
    <ManagePackageVersionsCentrally Condition="'$(ManagePackageVersionsCentrally)' == ''">$(MSBuildProjectFullPath.StartsWith('$(MSBuildThisFileDirectory)', System.StringComparison.OrdinalIgnoreCase))</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Optional isolated importer only; Tooling and Runtime do not reference native Assimp. -->
    <PackageVersion Include="AssimpNetter" Version="[6.0.5]" />
    <PackageVersion Include="TrueMoon.MiniAudioEx" Version="4.0.1-truemoon.1" />
    <!-- Local patched Windows x64 dependency; see eng/native/MiniAudioEx. -->
    <PackageVersion Include="BepuPhysics" Version="[2.5.0-beta.33]" />
    <PackageVersion Include="BepuUtilities" Version="[2.5.0-beta.33]" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Silk.NET" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing.Extensions.Veldrid" Version="2.23.0" />
    <PackageVersion Include="SkiaSharp" Version="4.156.1" />
    <PackageVersion Include="Topten.RichTextKit" Version="0.6.173" />
    <PackageVersion Include="Veldrid.SPIRV" Version="1.0.15" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" PrivateAssets="all" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" PrivateAssets="all" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
