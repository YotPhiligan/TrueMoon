<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TrueMoon.Aether.Editor.Tooling</RootNamespace>
    <AssemblyName>TrueMoon.Aether.Editor.Tooling</AssemblyName>
    <PackageId>TrueMoon.Aether.Editor.Tooling</PackageId>
    <OutputType>Library</OutputType>
    <TargetFramework>$(TF)</TargetFramework>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Full Editor Tooling adapters and composition.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageTags>$(PackageTags);aether;editor;ui;authoring</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TrueMoon.Aether.Editor.UI/TrueMoon.Aether.Editor.UI.csproj" />
    <ProjectReference Include="../TrueMoon.Contracts/TrueMoon.Contracts.csproj" />
    <ProjectReference Include="../TrueMoon.Aether.Tooling/TrueMoon.Aether.Tooling.csproj" />
    <ProjectReference Include="../TrueMoon.Alloy.Hosting/TrueMoon.Alloy.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="PACKAGE.md" Pack="true" PackagePath="PACKAGE.md" />
  </ItemGroup>
</Project>
