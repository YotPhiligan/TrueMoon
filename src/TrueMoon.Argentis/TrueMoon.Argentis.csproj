<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(TF)</TargetFramework>
        <Description>Backend-independent retained UI controls, property bindings, layout and input contracts for TrueMoon Alloy. Alpha API.</Description>
        <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
        <PackageTags>$(PackageTags);ui;controls;bindings;layout</PackageTags>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);GetArgentisAnalyzerPackageFiles</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="TrueMoon.Alloy" />
        <InternalsVisibleTo Include="TrueMoon.Alloy.Hosting" />
        <ProjectReference Include="..\TrueMoon.Contracts\TrueMoon.Contracts.csproj" />
        <ProjectReference Include="..\TrueMoon.Argentis.Generator\TrueMoon.Argentis.Generator.csproj"
                          ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
        <None Update="PACKAGE.md" Pack="true" PackagePath="PACKAGE.md" />
        <None Update="buildTransitive/TrueMoon.Argentis.targets" Pack="true" PackagePath="buildTransitive/TrueMoon.Argentis.targets" />
    </ItemGroup>

    <Target Name="GetArgentisAnalyzerPackageFiles">
        <MSBuild Projects="$(MSBuildProjectDirectory)/../TrueMoon.Argentis.Generator/TrueMoon.Argentis.Generator.csproj"
                 Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
            <Output TaskParameter="TargetOutputs" ItemName="_ArgentisAnalyzerPackageFiles" />
        </MSBuild>
        <Error Condition="!Exists('%(_ArgentisAnalyzerPackageFiles.Identity)')"
               Text="Build the Argentis generator before packing Argentis." />
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_ArgentisAnalyzerPackageFiles)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>
</Project>
