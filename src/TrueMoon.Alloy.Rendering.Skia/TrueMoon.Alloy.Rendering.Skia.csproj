<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TF)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Raster, OpenGL and Vulkan rendering for Alloy with bundled extended Skia for Windows x64. Alpha API.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TrueMoon.Alloy/TrueMoon.Alloy.csproj" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Topten.RichTextKit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep our extension separate from the upstream native-assets package. The host resolves
         both SkiaSharp and the interop bindings to this same library before any native call. -->
    <None Remove="NativeAssets/win-x64/libSkiaSharp.dll" />
    <None Include="NativeAssets/win-x64/libSkiaSharp.dll"
          TargetPath="truemoon-native/win-x64/libSkiaSharp.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="nativeAssets/win-x64/" />
    <None Update="build/TrueMoon.Alloy.Rendering.Skia.targets"
          Pack="true" PackagePath="build/TrueMoon.Alloy.Rendering.Skia.targets" />
    <None Update="buildTransitive/TrueMoon.Alloy.Rendering.Skia.targets"
          Pack="true" PackagePath="buildTransitive/TrueMoon.Alloy.Rendering.Skia.targets" />
    <None Update="PACKAGE.md" Pack="true" PackagePath="PACKAGE.md" />
  </ItemGroup>
</Project>
