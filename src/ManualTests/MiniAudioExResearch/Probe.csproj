<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MiniAudioExResearch</AssemblyName>
    <RootNamespace>MiniAudioExResearch</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JAJ.Packages.MiniAudioEx" Version="4.0.1" />
    <!-- Fixture generation only; not a proposed dependency of the audio provider. -->
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
  </ItemGroup>
</Project>
