<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(TF)</TargetFramework>
    <RootNamespace>TrueMoon.ManualTests.AetherEditorHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Executable composition and acceptance consumer of the Aether editor module.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TrueMoon.Aether.Editor.Tests" />
    <ProjectReference Include="../../TrueMoon/TrueMoon.csproj" />
    <ProjectReference Include="../../TrueMoon.Extensions.DependencyInjection/TrueMoon.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="../../TrueMoon.Aether.Editor.Tooling/TrueMoon.Aether.Editor.Tooling.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../Examples/AetherEditor/Assets/Fonts/NotoSans-Regular.ttf" Link="Assets/Fonts/NotoSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Examples/AetherEditor/Assets/Fonts/OFL.txt" Link="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
