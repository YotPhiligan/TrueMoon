<Project>
  <PropertyGroup>
    <_TrueMoonFrameworkBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_TrueMoonFrameworkBuildProps>
    <_TrueMoonFrameworksOnly>true</_TrueMoonFrameworksOnly>
  </PropertyGroup>
  <Import Project="$(_TrueMoonFrameworkBuildProps)"
          Condition="('$(TF)' == '' or '$(TestsTF)' == '') and '$(_TrueMoonFrameworkBuildProps)' != ''" />
  <PropertyGroup>
    <_TrueMoonFrameworksOnly />
    <_TrueMoonFrameworkBuildProps />
  </PropertyGroup>
</Project>
