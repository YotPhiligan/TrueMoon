<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>Game.Logic</AssemblyName><RootNamespace>Game.Logic</RootNamespace></PropertyGroup>
  <ItemGroup Condition="'$(AetherAbstractionsPath)' == ''">
    <PackageReference Include="TrueMoon.Aether.Abstractions" Version="$(TrueMoonPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(AetherAbstractionsPath)' != ''">
    <!-- The runtime compiler freezes these references to the installed package DLLs. -->
    <Reference Include="TrueMoon.Aether.Abstractions" HintPath="$(AetherAbstractionsPath)" Private="false" />
    <Reference Include="TrueMoon.Contracts" HintPath="$(TrueMoonContractsPath)" Private="false" />
  </ItemGroup>
</Project>
