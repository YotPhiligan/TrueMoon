<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TF)</TargetFramework>
    <RootNamespace>TrueMoon.ManualTests.CobaltGeneratorConsumer.Presentation.Shell.WithLongNamespaces.ForGeneratedResolvers.AndGenericFactoryRegistrations</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated/$(Configuration)</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TrueMoon.Cobalt" Version="$(TrueMoonPackageVersion)" />
  </ItemGroup>
  <Target Name="CaptureCobaltAnalyzer" AfterTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)analyzers.txt" Lines="@(Analyzer)" Overwrite="true" />
  </Target>
</Project>
