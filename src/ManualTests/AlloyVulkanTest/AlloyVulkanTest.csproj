<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TF)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../TrueMoon.Alloy.Hosting/TrueMoon.Alloy.Hosting.csproj" />
    <ProjectReference Include="../../TrueMoon/TrueMoon.csproj" />
    <ProjectReference Include="../../TrueMoon.Extensions.DependencyInjection/TrueMoon.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="../../TrueMoon.Alloy.Platform.Silk/TrueMoon.Alloy.Platform.Silk.csproj" />
    <ProjectReference Include="../../TrueMoon.Alloy.Rendering.Skia/TrueMoon.Alloy.Rendering.Skia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Shaders/*.spv" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reuse the actual standalone scene and script; do not reference its executable. -->
    <Compile Include="../AlloyTest/View1.cs" Link="Settings/View1.cs" />
    <Compile Include="../AlloyTest/SettingsModel.cs" Link="Settings/SettingsModel.cs" />
    <Compile Include="../AlloyTest/SettingsRow.cs" Link="Settings/SettingsRow.cs" />
    <Compile Include="../AlloyTest/LoadStatus.cs" Link="Settings/LoadStatus.cs" />
    <Compile Include="../AlloyTest/LoadStatusRegion.cs" Link="Settings/LoadStatusRegion.cs" />
    <Compile Include="../AlloyTest/VolumeMeter.cs" Link="Settings/VolumeMeter.cs" />
    <Compile Include="../AlloyTest/SettingsFormSmoke.cs" Link="Settings/SettingsFormSmoke.cs" />
    <Content Include="../AlloyTest/Assets/alloy-mark.png" Link="Assets/alloy-mark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
