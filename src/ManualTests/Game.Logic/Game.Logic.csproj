<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TestsTF)</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../TrueMoon.Aether/TrueMoon.Aether.csproj" Condition="'$(AetherContractPath)' == ''" />
    <Reference Include="TrueMoon.Aether" Condition="'$(AetherContractPath)' != ''">
      <HintPath>$(AetherContractPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TrueMoon.Contracts" Condition="'$(AetherContractPath)' != ''">
      <HintPath>$(TrueMoonContractsPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
