<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>KtonResearch</AssemblyName>
    <RootNamespace>KtonResearch</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="[2.5.0-beta.33]" />
    <PackageReference Include="BepuUtilities" Version="[2.5.0-beta.33]" />
  </ItemGroup>
</Project>
