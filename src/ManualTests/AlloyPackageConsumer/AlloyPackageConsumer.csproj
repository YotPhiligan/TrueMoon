<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TrueMoonPackageVersion Condition="'$(TrueMoonPackageVersion)' == ''">0.2.2.7-alpha</TrueMoonPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TrueMoon.Alloy.Hosting" Version="$(TrueMoonPackageVersion)" />
    <PackageReference Include="TrueMoon" Version="$(TrueMoonPackageVersion)" />
    <PackageReference Include="TrueMoon.Extensions.DependencyInjection" Version="$(TrueMoonPackageVersion)" />
  </ItemGroup>
</Project>
