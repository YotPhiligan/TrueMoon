<Project>
  <Target Name="VerifyIndependentConsumer" BeforeTargets="CoreCompile">
    <Error Condition="'@(ProjectReference)' != ''" Text="Only PackageReference is allowed in this consumer." />
    <WriteLinesToFile File="$(IntermediateOutputPath)resolved-analyzers.txt" Lines="@(Analyzer)" Overwrite="true" />
  </Target>
</Project>
