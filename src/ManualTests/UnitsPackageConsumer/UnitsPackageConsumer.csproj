<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UnitsPackageConsumer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
    <EnableCobaltGenerator Condition="'$(EnableCobaltGenerator)' == ''">true</EnableCobaltGenerator>
    <EnableEneritGenerator Condition="'$(EnableEneritGenerator)' == ''">true</EnableEneritGenerator>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated/$(Configuration)</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TrueMoon" Version="$(TrueMoonPackageVersion)" />
    <PackageReference Include="TrueMoon.Enerit" Version="$(TrueMoonPackageVersion)" />
    <PackageReference Include="TrueMoon.Mithril" Version="$(TrueMoonPackageVersion)" />
    <PackageReference Include="TrueMoon.Extensions.DependencyInjection" Version="$(TrueMoonPackageVersion)" />
    <PackageReference Include="TrueMoon.Enerit.Generator" Version="$(TrueMoonPackageVersion)" PrivateAssets="all" Condition="'$(EnableEneritGenerator)' == 'true'" />
  </ItemGroup>
</Project>
