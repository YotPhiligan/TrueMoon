<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TF)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Optional TrueMoon Alloy App integration and Windows x64 standalone OpenGL/Vulkan hosting. Alpha API.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageTags>$(PackageTags);ui;hosting;windowing;lifecycle</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Topten.RichTextKit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TrueMoon.Alloy/TrueMoon.Alloy.csproj" />
    <ProjectReference Include="../TrueMoon.Alloy.Rendering.Skia/TrueMoon.Alloy.Rendering.Skia.csproj" />
    <ProjectReference Include="../TrueMoon.Alloy.Platform.Silk/TrueMoon.Alloy.Platform.Silk.csproj" />
    <ProjectReference Include="../TrueMoon.Contracts/TrueMoon.Contracts.csproj" />
    <ProjectReference Include="../TrueMoon.Core/TrueMoon.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="PACKAGE.md" Pack="true" PackagePath="PACKAGE.md" />
  </ItemGroup>
</Project>
