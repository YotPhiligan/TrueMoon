      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Test the actual sample widget source without introducing an App/Silk dependency into this test project. -->
    <Compile Include="..\ManualTests\AlloyTest\LoadStatus.cs" Link="Demo\LoadStatus.cs" />
