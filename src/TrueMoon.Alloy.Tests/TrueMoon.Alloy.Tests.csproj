    <Compile Include="..\ManualTests\AlloyTest\SettingsModel.cs" Link="Demo\SettingsModel.cs" />
    <Compile Include="..\ManualTests\AlloyTest\SettingsRow.cs" Link="Demo\SettingsRow.cs" />
    <Compile Include="..\ManualTests\AlloyTest\View1.cs" Link="Demo\View1.cs" />
    <Compile Include="..\ManualTests\AlloyTest\VolumeMeter.cs" Link="Demo\VolumeMeter.cs" />
    <Compile Include="..\TrueMoon.Alloy.Platform.Silk\Win32Clipboard.cs" Link="Platform\Win32Clipboard.cs" />
    <Compile Include="..\TrueMoon.Alloy.Platform.Silk\Win32ClipboardApi.cs" Link="Platform\Win32ClipboardApi.cs" />
    <Compile Include="..\TrueMoon.Alloy.Platform.Silk\WindowPixelScale.cs" Link="Platform\WindowPixelScale.cs" />
    <Compile Include="..\TrueMoon.Alloy.Platform.Silk\WindowCallbackBoundary.cs" Link="Platform\WindowCallbackBoundary.cs" />
    <Content Include="..\ManualTests\AlloyTest\Assets\alloy-mark.png" Link="Assets\alloy-mark.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TrueMoon.Argentis\TrueMoon.Argentis.csproj" />
    <ProjectReference Include="..\TrueMoon.Alloy\TrueMoon.Alloy.csproj" />
    <ProjectReference Include="..\TrueMoon.Alloy.Rendering.Skia\TrueMoon.Alloy.Rendering.Skia.csproj" />
