<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TrueMoon.Aether.Editor.UI</RootNamespace>
    <AssemblyName>TrueMoon.Aether.Editor.UI</AssemblyName>
    <PackageId>TrueMoon.Aether.Editor.UI</PackageId>
    <OutputType>Library</OutputType>
    <TargetFramework>$(TF)</TargetFramework>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Independent runtime editor views, presentation ports and styles.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageTags>$(PackageTags);aether;editor;ui;authoring</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TrueMoon.Contracts/TrueMoon.Contracts.csproj" />
    <ProjectReference Include="../TrueMoon.Aether.Runtime/TrueMoon.Aether.Runtime.csproj" />
    <ProjectReference Include="../TrueMoon.Alloy.Hosting/TrueMoon.Alloy.Hosting.csproj" />
    <ProjectReference Include="../TrueMoon.Argentis.Generator/TrueMoon.Argentis.Generator.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Update="PACKAGE.md" Pack="true" PackagePath="PACKAGE.md" />
  </ItemGroup>
</Project>
