<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TF)</TargetFramework>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Experimental TrueMoon game engine module: session lifecycle, checkpoint replacement, CPU/GPU viewport transport and a Windows Vulkan primitive renderer.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageTags>$(PackageTags);game-engine;sessions;ipc;frames</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" />
    <ProjectReference Include="../TrueMoon.Contracts/TrueMoon.Contracts.csproj" />
    <ProjectReference Include="../TrueMoon.Enerit/TrueMoon.Enerit.csproj" />
    <ProjectReference Include="../TrueMoon.Mithril/TrueMoon.Mithril.csproj" />
    <ProjectReference Include="../TrueMoon.Enerit.Generator/TrueMoon.Enerit.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Update="PACKAGE.md" Pack="true" PackagePath="PACKAGE.md" />
    <EmbeddedResource Include="Gpu/Vulkan/Shaders/*.spv" />
  </ItemGroup>
</Project>
