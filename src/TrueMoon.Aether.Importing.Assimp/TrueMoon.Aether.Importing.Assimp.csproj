<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TF)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <Description>Optional isolated Windows x64 Assimp worker for Aether CPU model import.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TrueMoon.Aether.Tooling/TrueMoon.Aether.Tooling.csproj" />
    <PackageReference Include="AssimpNetter" />
  </ItemGroup>
  <ItemGroup>
    <None Update="AssimpNetter.License.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="$(MSBuildThisFileDirectory)..\..\LICENSE" Link="TrueMoon.LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
