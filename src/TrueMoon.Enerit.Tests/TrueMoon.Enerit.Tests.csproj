<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(TestsTF)</TargetFramework>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\TrueMoon.Enerit\TrueMoon.Enerit.csproj" />
      <ProjectReference Include="..\TrueMoon\TrueMoon.csproj" />
      <ProjectReference Include="../ManualTests/EneritPipesProbe/EneritPipesProbe.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="CopyEneritProcessFixture" AfterTargets="Build">
      <ItemGroup>
        <EneritProcessFixture Include="../ManualTests/EneritPipesProbe/bin/$(Configuration)/$(TestsTF)/**/*" />
      </ItemGroup>
      <Copy SourceFiles="@(EneritProcessFixture)" DestinationFiles="@(EneritProcessFixture->'$(OutDir)enerit-fixture/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
</Project>
